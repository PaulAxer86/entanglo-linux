#!/bin/sh
# cargo-deb maintainer script: loads uinput, reloads the installed
# udev rule, and reapplies it so /dev/uinput gets GROUP/MODE without
# a reboot. The modules-load.d file makes the same state persistent.
# See ROADMAP.md Phase 1 and packaging/60-entanglo-uinput.rules.
set -e

if command -v modprobe >/dev/null 2>&1; then
    modprobe uinput || true
elif [ -x /usr/sbin/modprobe ]; then
    /usr/sbin/modprobe uinput || true
fi

if [ -x /usr/bin/udevadm ] || [ -x /sbin/udevadm ]; then
    udevadm control --reload-rules || true
    udevadm trigger --action=change --sysname-match=uinput || true
fi

cat <<'EOF'
Entanglo installed. To use input sharing, add yourself to the
'input' group and log out/in once:

    sudo usermod -aG input $USER

EOF

exit 0
